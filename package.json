{
  "name": "medlabel-extension",
  "version": "0.1.2",
  "private": true,
  "description": "Chrome extension that prints medication infusion labels from the MedLabel server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier \"**/*.{md,html,json,css,ts}\" --write",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "sync:contract": "tsx scripts/sync-contract.ts",
    "check:contract": "tsx scripts/check-contract.ts",
    "keygen": "tsx scripts/keygen.ts",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/js": "^9.19.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.2",
    "crx3": "^1.1.3",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^15.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix"
    ],
    "**/*.{md,html,json,css}": [
      "prettier --write"
    ]
  }
}
